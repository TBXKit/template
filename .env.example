# Public token for the Tebex Headless API (https://creator.tebex.io/developers/api-keys).
# Safe to be readable by the server process; used for storefront reads (webstore, categories, packages).
TEBEX_PUBLIC_TOKEN=""

# Canonical absolute URL this store is deployed at (no trailing slash), e.g. "https://store.example.com".
# Used to build absolute URLs in robots.txt, sitemap.xml, and Open Graph/canonical metadata.
# Defaults to "http://localhost:3000" if unset.
SITE_URL=""

# Optional Discord invite link, e.g. "https://discord.gg/example". Shown in the footer when set;
# the footer's Tebex merchant-of-record disclosure and legal links are unaffected either way.
DISCORD_URL=""

# Controls what the homepage ("/") renders. Defaults to "template" (unset behaves the same way):
# a generic getting-started placeholder instead of live categories/packages, for a freshly-cloned
# store that has a token but no populated catalog yet. Set to "storefront" once your store's
# catalog is built out, to render live categories/packages on the homepage instead. Every other
# route (/category/[id], /package/[id], /search, /cart, ...) always renders live data regardless
# of this setting, and TEBEX_PUBLIC_TOKEN is still required either way.
HOMEPAGE_MODE=""